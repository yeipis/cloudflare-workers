{
  "name": "cloudflare-workers-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "dev:placeholder": "pnpm --filter project-placeholder dev",
    "deploy:placeholder": "pnpm --filter project-placeholder deploy",
    "dev:email-reject": "pnpm --filter email-catch-all-reject dev",
    "deploy:email-reject": "pnpm --filter email-catch-all-reject deploy",
    "deploy:all": "pnpm -r deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.2"
  }
}
