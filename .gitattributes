# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Text file types
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
